{
  "$defs": {
    "DocBuild": {
      "description": "A single documentation build option.",
      "properties": {
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "build_command": {
          "items": {
            "type": "string"
          },
          "title": "Build Command",
          "type": "array"
        }
      },
      "required": [
        "path",
        "build_command"
      ],
      "title": "DocBuild",
      "type": "object"
    },
    "DocType": {
      "description": "The type of documentation in this project.",
      "enum": [
        "end-user",
        "developer",
        "documenter"
      ],
      "title": "DocType",
      "type": "string"
    },
    "Part": {
      "properties": {
        "plugin": {
          "title": "Plugin",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "plugin",
        "source"
      ],
      "title": "Part",
      "type": "object"
    }
  },
  "description": "docscraft.yaml\n\nThis file describes how Docscraft will build your documentation.\nWe have to be careful with this docstring because it gets used in the schema but\ncould also be used in the docs themselves.",
  "properties": {
    "name": {
      "description": "A name for this docscraft project. (This text shows up in the JSON schema)",
      "examples": [
        "snapcraft",
        "charmcraft",
        "rockcraft"
      ],
      "maxLength": 79,
      "title": "Project name",
      "type": "string"
    },
    "testKey": {
      "description": "json description",
      "examples": [
        1,
        2,
        3
      ],
      "title": "Testkey",
      "type": "integer"
    },
    "type": {
      "$ref": "#/$defs/DocType"
    },
    "build": {
      "$ref": "#/$defs/DocBuild"
    },
    "parts": {
      "additionalProperties": {
        "$ref": "#/$defs/Part"
      },
      "description": "Mapping of part names to their information.",
      "examples": [
        {
          "my-part": {
            "plugin": "nil"
          }
        }
      ],
      "title": "Parts",
      "type": "object"
    }
  },
  "required": [
    "name",
    "testKey",
    "type",
    "build",
    "parts"
  ],
  "title": "Docscraft",
  "type": "object"
}
